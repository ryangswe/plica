{
  "name": "plica",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny, fast viewer for Markdown, JSON, CSV, notebooks, logs, diffs and other dev files, with a one-key raw/rendered toggle.",
  "license": "MIT",
  "homepage": "https://github.com/ryangswe/plica",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ryangswe/plica.git"
  },
  "bugs": "https://github.com/ryangswe/plica/issues",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware --deny-warnings",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.2.0",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.3.0",
    "papaparse": "^5.7.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@tauri-apps/cli": "^2.12.4",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^31.0.0",
    "oxlint": "1.93.0",
    "oxlint-tsgolint": "7.0.2006",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
