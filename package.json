{
  "name": "plica",
  "private": true,
  "version": "0.1.0",
  "description": "A tiny, fast viewer for Markdown, JSON, CSV, notebooks, logs, diffs and other dev files, with a one-key raw/rendered toggle.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 1420 --strictPort",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "dompurify": "^3.4.17",
    "highlight.js": "^11.12.0",
    "marked": "^18.1.1",
    "marked-highlight": "^2.2.4",
    "mermaid": "^12.2.0",
    "papaparse": "^5.7.0"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.12.3",
    "@types/papaparse": "^5.5.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
