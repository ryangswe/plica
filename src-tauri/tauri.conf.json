{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Plica",
  "version": "0.1.0",
  "identifier": "dev.plica.viewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' asset: http://asset.localhost https: http: data: blob:",
        "font-src": "'self' data:",
        "connect-src": "ipc: http://ipc.localhost",
        "frame-src": "'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "dangerousDisableAssetCspModification": [
        "style-src"
      ],
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": [
            "**"
          ],
          "deny": [
            "**/.ssh/**",
            "**/.gnupg/**",
            "**/.aws/**",
            "**/.kube/**",
            "**/.docker/**",
            "**/.netrc",
            "**/.git-credentials"
          ],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Fast viewer for Markdown and other dev files",
    "longDescription": "Plica opens Markdown, JSON, CSV, notebooks, logs, diffs and other developer files instantly, rendered, with a one-key toggle to the raw source.",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkd",
          "mkdn"
        ],
        "name": "Markdown document",
        "description": "Markdown document",
        "role": "Viewer",
        "mimeType": "text/markdown"
      },
      {
        "ext": [
          "json",
          "jsonc",
          "geojson"
        ],
        "name": "JSON file",
        "description": "JSON file",
        "role": "Viewer",
        "mimeType": "application/json"
      },
      {
        "ext": [
          "jsonl",
          "ndjson"
        ],
        "name": "JSON Lines file",
        "description": "JSON Lines file",
        "role": "Viewer",
        "mimeType": "application/x-ndjson"
      },
      {
        "ext": [
          "csv"
        ],
        "name": "CSV file",
        "description": "Comma-separated values",
        "role": "Viewer",
        "mimeType": "text/csv"
      },
      {
        "ext": [
          "tsv"
        ],
        "name": "TSV file",
        "description": "Tab-separated values",
        "role": "Viewer",
        "mimeType": "text/tab-separated-values"
      },
      {
        "ext": [
          "ipynb"
        ],
        "name": "Jupyter notebook",
        "description": "Jupyter notebook",
        "role": "Viewer",
        "mimeType": "application/x-ipynb+json"
      },
      {
        "ext": [
          "log"
        ],
        "name": "Log file",
        "description": "Log file",
        "role": "Viewer",
        "mimeType": "text/x-log"
      },
      {
        "ext": [
          "diff",
          "patch"
        ],
        "name": "Patch file",
        "description": "Unified diff",
        "role": "Viewer",
        "mimeType": "text/x-diff"
      },
      {
        "ext": [
          "mmd",
          "mermaid"
        ],
        "name": "Mermaid diagram",
        "description": "Mermaid diagram",
        "role": "Viewer",
        "mimeType": "text/vnd.mermaid"
      },
      {
        "ext": [
          "txt",
          "text"
        ],
        "contentTypes": [
          "public.plain-text",
          "public.source-code",
          "public.script"
        ],
        "name": "Text file",
        "description": "Plain text or source code",
        "role": "Viewer",
        "rank": "Alternate",
        "mimeType": "text/plain"
      }
    ],
    "linux": {
      "deb": {
        "section": "devel",
        "desktopTemplate": "linux/plica.desktop"
      },
      "rpm": {
        "desktopTemplate": "linux/plica.desktop"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
